rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for Track entity
    function isValidTrackBase(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 1000 &&
             data.genre is string && data.genre.size() > 0 && data.genre.size() <= 100 &&
             (data.get('lyrics', '') is string) &&
             (data.get('audioUrl', '') is string);
    }

    function isValidTrackCreate(data) {
      return isValidTrackBase(data) && 
             data.createdAt == request.time;
    }

    function isValidTrackUpdate(data) {
      return isValidTrackBase(data);
    }

    // Validation helper for UserPlan entity
    function isValidUserPlan(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.tier is string && (data.tier == 'free' || data.tier == 'plus' || data.tier == 'pro' || data.tier == 'ultra') &&
             data.dailyGenerations is int && data.dailyGenerations >= 0 &&
             data.monthlyGenerations is int && data.monthlyGenerations >= 0 &&
             data.lastGenerationDate is string && data.lastGenerationDate.size() <= 64 &&
             data.lastGenerationMonth is string && data.lastGenerationMonth.size() <= 64;
    }

    match /tracks/{trackId} {
      // Allow individual track lookup only for signed-in users
      allow get: if isSignedIn() && isValidId(trackId); 
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(trackId) && isValidTrackCreate(incoming());
      
      allow update: if isOwner(existing().userId) && 
                      isValidId(trackId) &&
                      isValidTrackUpdate(incoming()) &&
                      incoming().userId == existing().userId &&
                      // Action: Metadata update
                      incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'genre', 'lyrics', 'audioUrl']);
      
      allow delete: if isOwner(existing().userId) && isValidId(trackId);
    }

    match /userProfiles/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserPlan(incoming()) && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidUserPlan(incoming()) && incoming().updatedAt == request.time;
    }
  }
}
